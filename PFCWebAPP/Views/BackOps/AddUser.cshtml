    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewData["Title"] = "Add User";
}
@model PFCWebAPP.DatabaseContext.Models.CustomTables.UserMaster


<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="~/BackOps/Users">Users </a></li>
        <li class="breadcrumb-item active" aria-current="page">Add User</li>
    </ol>
</nav>
<div style="background:#fafafa;padding:13px;">
   
    <div class="row">
        <div>
            <h2 class="text-center">Add User</h2>
        </div>
    </div>
   @* <div asp-validation-summary="All" class="text-danger"></div>*@
    <form asp-controller="BackOps" asp-action="AddUser" method="post" id="AddUser" class="mt-3">
        <div class="container">
            <div class="row form-group inputfocus">
                <div class="col-md-4">
                    <div class="row">
                        <div class="col-md-12">
                            <label asp-for="UserSESA" col-form-label></label><sup class="text-danger" style="font-size:14px">*</sup>
                            <input asp-for="UserSESA" class="form-control" placeholder="Enter UserSESA">
                            <span asp-validation-for="UserSESA" class="text-danger mt-2 ps-1" style="display:block;font-size: 12px;"></span>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="row">
                        <div class="col-md-12">
                            <label asp-for="FirstName" col-form-label></label><sup class="text-danger" style="font-size:14px">*</sup>
                            <input asp-for="FirstName" class="form-control" placeholder="Enter First Name">
                            <span asp-validation-for="FirstName" class="text-danger mt-2 ps-1" style="display:block;font-size: 12px;"></span>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="row">
                        <div class="col-md-12">
                            <label asp-for="LastName" col-form-label></label>
                            <input asp-for="LastName" class="form-control" placeholder="Enter Last Name">
                            <span asp-validation-for="LastName" class="text-danger mt-2 ps-1" style="display:block;font-size: 12px;"></span>
                        </div>
                    </div>
                </div>


            </div>
            <div class="row form-group">
                <div class="col-md-4">
                    <div class="row">
                        <div class="col-md-12">
                            <label asp-for="Email" col-form-label></label><sup class="text-danger" style="font-size:14px">*</sup>
                            <input asp-for="Email" class="form-control" placeholder="Enter Email">
                            <span asp-validation-for="Email" class="text-danger mt-2 ps-1" style="display:block;font-size: 12px;"></span>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="row">
                        <div class="col-md-12">
                            <label asp-for="Department" col-form-label></label>
                            <input asp-for="Department" class="form-control" placeholder="Enter Department">
                            <span asp-validation-for="Department" class="text-danger mt-2 ps-1" style="display:block;font-size: 12px;"></span>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="row">
                        <div class="col-md-12">
                            <label asp-for="Country" col-form-label></label><sup class="text-danger" style="font-size:14px">*</sup>
                            <input asp-for="Country" class="form-control" placeholder="Enter Country">
                            <span asp-validation-for="Country" class="text-danger mt-2 ps-1" style="display:block;font-size: 12px;"></span>
                        </div>
                    </div>
                </div>
            </div>
            @*@if (Model.UserMasterID > 0)
            {
                <div>
                    <label asp-for="IsActive" col-form-label>IsActive</label><sup class="text-danger" style="font-size:14px">*</sup>
                    <input type="checkbox" asp-for="IsActive" role="switch" data-bs-toggle="modal" data-bs-target="#exampleModal" />
                </div>
            }*@
            <div class="row form-group">
                <div class="col-md-4">
                    <div class="row">
                        <div class="col-md-12">
                            <input asp-for="UserMasterID" class="form-control" hidden>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="row">
                        <div class="col-md-12">
                            <input asp-for="CreatedBy" class="form-control" hidden>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="row">
                        <div class="col-md-12">
                            <input asp-for="CreatedDate" class="form-control" hidden>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="row">
                        <div class="col-md-12">
                            <input asp-for="ModifiedBy" class="form-control" hidden>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="row">
                        <div class="col-md-12">
                            <input asp-for="ModifiedDate" class="form-control" hidden>
                        </div>
                    </div>
                </div>
            </div>
            <div class="form-group row">
               
                    <div class="col-sm-10">
                        <button type="submit" class="btn btn-primary" id="btnSave">Save</button>
                    </div>
            </div>
        </div>
    </form>


    <div class="modal fade" id="enableDeletedPortalUser" tabindex="-1" aria-labelledby="enableDeletedPortalUserLabel" aria-hidden="true" role="dialog">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLabel"><Strong>Enable User</Strong></h5>
@*                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>*@
                </div>
                <div class="modal-body" id="my-modal-body"> </div>
                <div class="modal-footer">
                    <form>
                        <button type="button" class="btn btn-success" id="enablePotralUser">Yes</button>
                        <button type="button" class="btn btn-primary" data-bs-dismiss="modal" id="disablePotralUser">No</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    $(function () {
        
        //to disable buttons on page load

        $("#btnSave").attr('disabled', true);
        //end to disable buttons on page load

        //to allow user to enter only alphanumeric
        $('#UserSESA').on('keypress', function (event) {
            var regex = new RegExp("^[a-zA-Z0-9]+$");
            var key = String.fromCharCode(!event.charCode ? event.which : event.charCode);
            if (!regex.test(key)) {
                event.preventDefault();
                return false;
            }   
        });

        //to enable save and update buttons on change any fields in form
        $('#AddUser').change(function() {
            $("#btnSave").attr('disabled', false);
        });

        // to check the user status after entering the UserSESA
        $('#UserSESA').focusout(function() {
            checkUserStatus();
        });

        function checkUserStatus(){
            var UserSESA = $('#UserSESA').val();
            if (UserSESA.trim().length >= 7) {
                $.ajax({
                    type: 'Post',
                    url: '@Url.Action("IsDeletedPortalUser", "BackOps")',
                    data: { UserSESA: UserSESA },
                    datatype: JSON,
                    success: function (data) {
                        if (data == true) {
                            var cur_text = '@PFCWebAPP.Utilities.AppConfig.ReActivePortalAccess';
                            var strongtext = "<b>" + UserSESA + "</b>";
                            var new_text = cur_text +" "+ strongtext;
                            $('#my-modal-body').empty();
                            $('#my-modal-body').html(new_text);
                            $("#enableDeletedPortalUser").modal('show');

                        }
                    },
                    error: function (data) {
                        //alert(data);
                        console.log(data);
                        //location.reload(true);
                        $("#RelanchModal").modal('show');
                    }
                });
            }
        }

        $('#btnSave').click(function (e) {
                checkUserStatus();
        });

        //if the UserSESA is an existing record and want to enable Portal Access
        $('#enablePotralUser').click(function() {
            var UserSESA = $('#UserSESA').val();
            $.ajax({
                type : 'Post',
                data: { UserSESA: UserSESA, CanReActivateUser: true },
                url: '@Url.Action("DeleteorReActivateUser", "BackOps")',
                datatype: JSON,
                success : function(data){

                     if (data != null && data == "success") {
                        $("#enableDeletedPortalUser").modal('hide');
                        window.location.href = './Users';
                     }
                     else
                     {
                          alert(data);
                     } 
                },
                error : function(data){
                    //alert(data);
                    console.log(data);
                    //location.reload(true);
                    $("#RelanchModal").modal('show');
                }
            });
        });

        //if User denies the enable Portal Access Confirmation
        $('#disablePotralUser').click(function() {
            $('#UserSESA').val('');
            $("#enableDeletedPortalUser").modal('hide');
        });
    });
</script>