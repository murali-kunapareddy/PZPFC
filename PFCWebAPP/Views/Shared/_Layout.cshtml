<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]  :: @PFCWebAPP.Utilities.AppConfig.ApplicationShortName</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-1BmE4kWBq78iYhFldvKuhfTAU6auU8tT94WrHftjDbrCEXSU1oBoqyl2QvZ6jIW3" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.1/font/bootstrap-icons.css">
    <link href="~/css/SE/reset.css" rel="stylesheet" />
    <link href="~/css/SE/main.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.css" />
 
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.4/jquery.min.js"></script>



    @*    <script src="~/js/se/jquery.datatables.1.10.12.min.js"></script>
    <script src="~/js/se/datatables.bootstrap.min.js"></script>   *@


    <style>
        .dropdown-menu.show {
            background: var(--dark-green);
        }

        .loader {
            position: fixed;
            left: 0px;
            top: 0px;
            width: 100%;
            height: 100%;
            z-index: 9999;
           /* background: url('/images/loadingcircle.gif') 50% 50% no-repeat rgb(249,249,249);*/
        }

        .disabled {
            pointer-events: none;
            opacity: 0.4;
        }
    </style>
</head>

<body>
    <div>
        <header>
            @(await Component.InvokeAsync("UserRoleMenuDetails"))
        </header>
        <div class="container">
            <br />
            <br />
            <main role="main">
                @RenderBody()
            </main>
            <footer>
                <div class="container-fluid p-3 fixed-bottom">
                    <div class="row">
                        <div class="col-lg-6">
                            <a href="#">Site Map</a>
                            <a href="#">Legal Information</a>
                            <a href="#">Privacy and Cookie Policy</a>
                            <a href="#">Terms & Conditions</a>
                        </div>
                        <div class="col-lg-6 text-end">
                            @PFCWebAPP.Utilities.AppConfig.BildVersion

                        </div>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <div id="processOverlay" class="overlay">
        <div class="text-hole-center">
            <img src="~/images/loadingcircle.gif" class="center-img" style="width:100px;height:100px" />
        </div>
    </div>



    <div class="modal fade" id="RelanchModal" tabindex="-1" aria-labelledby="SessionCheckLabel" aria-hidden="true" role="dialog">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content  modal-dialog-centered">
                <div class="modal-body">
                    @PFCWebAPP.Utilities.AppConfig.SessionExpire
                </div>
                <div class="modal-footer text-end">
                     <button type="button" data-bs-dismiss="modal" aria-label="Close" class="btn btn-primary" id="LocationReloadBtn">OK</button>
                </div>
            </div>
        </div>
    </div>
\
    <div class="modal fade" id="staticBackdrop" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="staticBackdropLabel">ETL Job Status</h5>
                </div>
                <div class="modal-body">
                    @PFCWebAPP.Utilities.AppConfig.EtlInProgressMsg
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="staticBackdrop1" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="staticBackdropLabel1">ETL Job Status</h5>
                </div>
                <div class="modal-body">
                    @PFCWebAPP.Utilities.AppConfig.EtlYetToStartMsg
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>


    <script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.4/moment.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-ka7Sk0Gln4gmtz2MlQnikT1wXgYsOg+OMhuP+IlRH9sENBO0LRn5q+8nbTov4+1p"
            crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://ajax.aspnetcdn.com/ajax/mvc/5.2.3/jquery.validate.unobtrusive.min.js"></script>
    <script src="https://unpkg.com/ag-grid-community/dist/ag-grid-community.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.js"></script>

    <script src="~/js/SE/main.js"></script>


    <script>
        $("#processOverlay").css("width", "100%");
        //$('body').append('<div style="" id="loadingDiv"><div class="loader">Loading...</div></div>');
        $(window).on('load', function () {
            setTimeout(removeLoader, 100); //wait for page load PLUS two seconds.
        });
        function removeLoader() {
            $("#processOverlay").css("width", "0%");
        }


        $(document).ready(function () {

            $("#RelanchModal").modal({
                show: false,
                backdrop: 'static'
            })

             $("#LocationReloadBtn").click(function () {
            location.reload(true);
        });

           

        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
