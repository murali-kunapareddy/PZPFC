    //generate button click
    function GeneratePriceList() {

        if (isEtlProcessing == true) {
                showPopup();
        }
        else{

        

        if ($("#orgLevel").val() == '0') {
            ShowPopupMessage("@PFCWebAPP.Utilities.AppConfig.PopUpHeaderValidation", "@PFCWebAPP.Utilities.AppConfig.SelectSalesOrganisation")
            return;
        }

        var GridTableData = [];
        gridApi.forEachNode((rowNode, index) => {
            GridTableData.push({
                CustomerSNO: index + 1,
                CustomerNumber: rowNode.data.KUNNR,
                CustomerName: rowNode.data.NAME1,
                zKUNNR: rowNode.data.xVKORG,
                PC1: rowNode.data.KVGR1,
                PC2: rowNode.data.KVGR2,
                PC3: rowNode.data.KVGR3,
                Organization: rowNode.data.Organization
            })

        });
        if (GridTableData.length <= 0) {
            ShowPopupMessage("@PFCWebAPP.Utilities.AppConfig.PopUpHeaderValidation", "@PFCWebAPP.Utilities.AppConfig.SelectAtleastSingleCustomer")
            return;
        }

        let maxCustomers = parseInt($("#maxCustomersCount").val())
        if (GridTableData.length > maxCustomers) {
            let msg = "@PFCWebAPP.Utilities.AppConfig.CustomerSelectionCountFromSettings" + maxCustomers;
            ShowPopupMessage("@PFCWebAPP.Utilities.AppConfig.PopUpHeaderValidation", msg)
            return;
        }
        var selected = [];
        $('#discountBinding input[type=checkbox]').each(function () {
            let ele = $(this).next().text().trim().split(' ')
            selected.push({
                FieldName: ele[1].trim(),
                FieldText: ele[3].replace(/[{()}]/g, '').trim(),
                Status: $(this).is(":checked")
            });

        });
        var autoReport = $("#chk_AutoReport").is(":checked")
        var sodvalue = ""
        if ($("#input_AddSod").val() == "") {
            sodvalue = 0
        } else {
            sodvalue = parseFloat($("#input_AddSod").val().split('%')[0]);
        }

        //if ($("#chk_UseGlobalCOS").is(":checked") == false && $("#chk_UseLocalCos").is(":checked") == false) {
        //    ShowPopupMessage("Validation", "Please Select any of COS Value")
        //    return;
        //}
        var chkTradePrices = $("#chk_IncludePrice").is(":checked")
        var chkNetPrices = $("#chk_IncludeNetPrice").is(":checked")
        var chkOverallNetPrices = $("#chk_IncludeOverallPrice").is(":checked")
        // message for excluding trade prices
        if (chkTradePrices == false) {
            if (chkNetPrices == false && chkOverallNetPrices == false) {
                ShowPopupMessage("@PFCWebAPP.Utilities.AppConfig.PopUpHeaderValidation", "@PFCWebAPP.Utilities.AppConfig.ExcludeNetTradePricesAndchkOverallNetPrices")
                return;
            }
        }
        // message for excluding netprices
        if (chkNetPrices == false) {
            if (chkTradePrices == false && chkOverallNetPrices == false) {
                ShowPopupMessage("@PFCWebAPP.Utilities.AppConfig.PopUpHeaderValidation", "@PFCWebAPP.Utilities.AppConfig.ExcludechkTradePricesAndchkOverallNetPrices")
                return;
            }
        }
        // message for excluding overallnet prices
        if (chkOverallNetPrices == false) {
            if (chkTradePrices == false && chkNetPrices == false) {
                ShowPopupMessage("@PFCWebAPP.Utilities.AppConfig.PopUpHeaderValidation", "@PFCWebAPP.Utilities.AppConfig.chkOverallNetPrices")
                return;
            }
        }

        if (autoReport == false && ($("#dp_tradeTemplate").val() <= 0)) {
            ShowPopupMessage("@PFCWebAPP.Utilities.AppConfig.PopUpHeaderValidation", "@PFCWebAPP.Utilities.AppConfig.SelectTradeTemplate")
            return;
        }
        if ($("#dp_templateOutput").val() <= 0) {
            ShowPopupMessage("@PFCWebAPP.Utilities.AppConfig.PopUpHeaderValidation", "@PFCWebAPP.Utilities.AppConfig.SelectTradeListFormat")
            return;
        }

        var toggle_value = $("#chk_toggle").is(":checked");

            // Assuming the values
            let useProductHierarchyOverridebeforeModify = $("#chk_UseProductHierarchyOverride").is(":checked");
            let useProductHierarchyOverride = $("#chk_UseProductHierarchyOverride").is(":checked");
            let activeData = new Date($("#active_Data").val());
            let productHierarchyOverrideDate = new Date(productHirearchyOverideDate);

            // Checking the condition using ternary operator
            useProductHierarchyOverride = (useProductHierarchyOverride && activeData < productHierarchyOverrideDate) ? false :
                (useProductHierarchyOverride &&  activeData >= productHierarchyOverrideDate) ? true :
                    useProductHierarchyOverride;

            // Setting the value back to the checkbox
            $("#chk_UseProductHierarchyOverride").prop("checked", useProductHierarchyOverride);

        var obj = {
            UserSESA: '',
            SalesOrganization: $("#orgLevel").val(),
            SelectedCustomers: JSON.stringify(GridTableData),
            PricesActiveDate: $("#active_Data").val(),
            CanUseAutoReportContent: autoReport,
            ReportContentTemplateID: autoReport == false ? parseInt($("#dp_tradeTemplate").val()) : 0,
            ReportFormatTemplateID: parseInt($("#dp_templateOutput").val()),
            CanIncludeTradePrices: $("#chk_IncludePrice").is(":checked"),
            CanIncludeCustomerNetPrices: $("#chk_IncludeNetPrice").is(":checked"),
            CanIncludeCustomerHierarchyNetPrices: $("#chk_CustHirearchy").is(":checked"),
            CanIncludeOverallNetPrices: $("#chk_IncludeOverallPrice").is(":checked"),
            CanIncludePriceGroupNets: $("#chk_IncludePriceGroup").is(":checked"),
            CanIncludeSellOffPrices: $("#chk_IncludeSaleOffPrice").is(":checked"),
            CanIncludeDiscount1: selected.find(x => x.FieldName == "Discount1").Status,
            CanIncludeDiscount2: selected.find(x => x.FieldName == "Discount2").Status,
            CanIncludeDiscount3: selected.find(x => x.FieldName == "Discount3").Status,
            CanIncludeDiscount4: selected.find(x => x.FieldName == "Discount4").Status,
            CanIncludeDiscount5: selected.find(x => x.FieldName == "Discount5").Status,
