@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Price List Generation";
}

@using PFCWebAPP.Repositories.PriceList.Models
@model ProcessBar

<div class="container">
    @*  <nav aria-label="breadcrumb">
    <ol class="breadcrumb">
    <li class="breadcrumb-item"><a href="/Home">Home</a></li>
    <li class="breadcrumb-item active" aria-current="page">Price List Generation</li>
    </ol>
    </nav>*@
    <h2>Price List Generation</h2>
    @* <button onclick="checkqueryPriceList()">click</button>*@
    <div class="row">
        <div class="col-lg-6">
            <div class="col-lg-12 d-flex">
                <div class="form-group col-lg-6 d-flex">
                    <div class="col-lg-5 d-flex align-items-center">
                        @*<sup class="text-danger" style="font-size:14px">*</sup>*@
                        <label for="userLevel"><strong>Sales Organization</strong></label>
                    </div>
                    <div class="col-lg-6">
                        <select class="form-control" id="orgLevel">
                            <option value="0">Select</option>
                        </select>
                    </div>
                    <input type="hidden" id="org_val" />
                </div>
                <div class="col-lg-6 text-end">
                    <input type="text" hidden id="maxCustomersCount">
                    <button class="btn btn-secondary me-2 clear-list" rippleEffect type="button" style="min-width:5rem!important">Clear</button>
                    <button class="btn btn-primary cleartablefilters" id="listCustomersPopup" rippleEffect data-bs-toggle="modal" data-bs-target="#exampleModal" style="min-width:5rem!important">List</button>
                    <button class="btn btn-primary" id="addClientToList" rippleEffect data-bs-toggle="modal" style="min-width:5rem!important">Add Customer</button>
                </div>
            </div>
            <div id="myGrid" style="height: 215px; width:100%;" class="ag-theme-alpine"></div>
        </div>
        <div class="col-lg-6">
            <div class="form-group col-lg-12 justify-content-end d-flex generate-button-top">
                <button class="btn btn-primary p-3 w-50" rippleEffect type="button" id="btn_GeneratePrice" onclick="handleGeneratePriceClick()"><strong>GENERATE PRICE LIST(S)</strong></button>
            </div>
            <div class="row ms-5" id="discountBinding">
            </div>
            <div class="form-group col-lg-12 ms-5">
                <div class="check-controls">
                    <label class=" me-3 d-flex align-items-center">Use Global COS/Product Hirearchy</label>
                    <label class="switch">
                        <input type="checkbox" id="chk_toggle">
                        <span class="slider round"></span>
                    </label>
                    <label class="ms-3 d-flex align-items-center">Use Local COS/Product Hirearchy</label>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-4">
        <div class="row">
            <div class="form-group col-lg-4">
                <label class="me-2"><strong>Date on which prices are "active":</strong></label>
                <input type="date" id="active_Data">
            </div>
            <div class="form-group col-lg-4">
                <div class="row">
                    <div class="check-controls col-lg-8 align-items-center mt-0">
                        <input type="checkbox" class="form-check-input" id="chk_AddSod">
                        <label><strong>Add SOD in final prices. Enter value</strong></label>
                    </div>
                    <div class="col-lg-3">
                        <input type="text" class="form-control float-number" id="input_AddSod">
                    </div>
                </div>
            </div>
            <div class="form-group col-lg-4">
                <div class="row">
                    <div class="check-controls col-lg-8 mt-0">
                        <input type="checkbox" class="form-check-input" id="chk_alter_filename">
                        <label><strong>Use alternative "Valid From" for file name</strong></label>
                    </div>
                    <div class="col-lg-4">
                        <input type="date" class="form-control" id="input_alter_filename">
                    </div>
                </div>
            </div>
        </div>
        <div class="row mt-2 check-container">
            <div class="col-lg-12">
                <div class="row">
                    <div class="form-group col-lg-3">
                        <div class="check-controls">
                            <input type="checkbox" class="form-check-input" id="chk_IncludePrice">
                            <label>Include Trade Prices</label>
                        </div>
                    </div>
                    <div class="form-group col-lg-3">
                        <div class="check-controls">
                            <input type="checkbox" class="form-check-input" id="chk_IncludeNetPrice">
                            <label>Include Customer Net Prices (A652)</label>
                        </div>
                    </div>
                    <div class="form-group col-lg-3">
                        <div class="check-controls">
                            <input type="checkbox" class="form-check-input" id="chk_CustHirearchy">
                            <label>Include Customer Hirearchy Net Prices (A657)</label>
                        </div>
                    </div>
                    <div class="form-group col-lg-3">
                        <div class="check-controls">
                            <input type="checkbox" class="form-check-input" id="chk_IncludeOverallPrice">
                            <label>Include Overall Net Prices (A655-ZNTP)</label>
                        </div>
                    </div>
                    <div class="form-group col-lg-3">
                        <div class="check-controls">
                            <input type="checkbox" class="form-check-input" id="chk_IncludePriceGroup">
                            <label>Include Price Group Nets</label>
                        </div>
                    </div>
                    <div class="form-group col-lg-3">
                        <div class="check-controls">
                            <input type="checkbox" class="form-check-input" id="chk_IncludeSaleOffPrice">
                            <label>Include Sell-Off Prices (A655-ZNT1)</label>
                        </div>
                    </div>
                    <div class="form-group col-lg-3">
                        <div class="check-controls">
                            <input type="checkbox" class="form-check-input" id="chk_IncludePromoPrice">
                            <label>Include Promo Price - Promo (ZPNP)</label>
                        </div>
                    </div>
                    <div class="form-group col-lg-3">
                        <div class="check-controls">
                            <input type="checkbox" class="form-check-input" id="chk_ShiftBreaks">
                            <label>Shift Breaks if Break 1 is 0</label>
                        </div>
                    </div>
                    <div class="form-group col-lg-3">
                        <div class="check-controls">
                            <input type="checkbox" class="form-check-input" id="chk_Moq">
                            <label>Use MOQ as Brk 1</label>
                        </div>
                    </div>
                    <div class="form-group col-lg-3">
                        <div class="check-controls">
                            <input type="checkbox" class="form-check-input" id="chk_ShowTemplateMaterialOnly">
                            <label>ShowTemplateMaterialOnly</label>
                        </div>
                    </div>
                    <div class="form-group col-lg-3">
                        <div class="check-controls">
                            <input type="checkbox" class="form-check-input" id="chk_AutoReport">
                            <label>Auto Report</label>
                        </div>
                    </div>
                    <div class="form-group col-lg-3">
                        <div class="check-controls">
                            <input type="checkbox" class="form-check-input" id="chk_SendMail">
                            <label>Send Mail</label>
                        </div>
                    </div>
                    <div class="form-group col-lg-3">
                        <div class="check-controls mt-2">
                            <input type="checkbox" class="form-check-input" id="chk_NotFoundMaterials">
                            <label>ShowNotFoundMaterials</label>
                        </div>
                    </div>
                    <div class="form-group col-lg-3">
                        <div class="check-controls mt-2">
                            <input type="checkbox" class="form-check-input" id="chk_UseProductHierarchyOverride">
                            <label>Use Product Hierarchy Override</label>
                        </div>
                    </div>
                    <div class="col-lg-3">
                        <div class="form-group col-lg-12 mt-2 d-flex">
                            <div class="col-lg-3 d-flex align-items-center">
                                <label for="userLevel">Trade List Template</label>
                            </div>
                            <div class="col-lg-9">
                                <select class="form-control" id="dp_tradeTemplate">
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-3">
                        <div class="form-group col-lg-12 mt-2 d-flex">
                            <div class="col-lg-3 d-flex align-items-center">
                                <label for="userLevel">Trade List Format</label>
                            </div>
                            <div class="col-lg-9">
                                <select class="form-control" id="dp_templateOutput">
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



<div class="modal fade list-modal" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel"><Strong>Customer List</Strong></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="modelGrid" style="height: 250px; width:100%;" class="ag-theme-alpine"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary list-selection" data-bs-dismiss="modal">Select</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="addClientModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addClientModalLabel"><Strong>Add Clients Manually</Strong></h5>
                <button type="button" class="btn-close" aria-label="Close" id="btnCloseModal" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="form-group col-lg-12 d-flex">
                    <div class="col-lg-3 d-flex align-items-center">
                        <label for="userLevel"><strong>Customer Templates</strong></label>
                    </div>
                    <div class="col-lg-9">
                        <select class="form-control" id="dp_Customertemplates">
                        </select>
                    </div>
                </div>
                <div class="form-group col-lg-12 d-flex">
                    <div class="col-lg-3 d-flex align-items-center">
                        <label for="userLevel"><strong>Additional customers:</strong></label>
                    </div>
                    <div class="col-lg-9">
                        <textarea id="txtAddCustomer" name="txtAddCustomer" rows="4" cols="50" class="form-control" style="overflow-y:scroll;width: 20rem;"></textarea>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" id="btnCloseaddClientModal" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary addCustManual" data-bs-dismiss="modal" id="addCustomerModalBtn">Add Customers</button>
            </div>
        </div>
    </div>
</div>


<div class="modal fade" id="commonModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><Strong id="commonModalTitle"></Strong></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="commonMessage">
            </div>
            <div class="modal-footer text-end">
                <button type="button" data-bs-dismiss="modal" aria-label="Close" class="btn btn-primary">Ok</button>
            </div>
        </div>
    </div>
</div>

<div id="processOverlay" class="overlay">
    <div class="text-hole-center">
        <img src="~/images/loadingcircle.gif" class="center-img" style="width:100px;height:100px" />
    </div>
</div>

<div class="modal fade" id="displayProcessModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><Strong>Process Status</Strong></h5>
            </div>
            <div class="modal-body" id="Processmsg">
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    let gridApi;
    let modelgridApi;
    var maxSelectionCustomers = 0;
    var intervalId = 1000;
    $("#processInnerDiv").hide();
    var downloadflag = true;
    var isEtlProcessing = false;
    var productHirearchyOverideDate = '';
    //main table config start
    const columnDefs = [
        { field: "KUNNR", headerName: "Customer Number", width: 150 },
        { field: "NAME1", headerName: "Customer Name" },
        { field: "xVKORG", headerName: "PCx", width: 100, hide: true },
        { field: "KVGR1", headerName: "PC1", width: 100 },
        { field: "KVGR2", headerName: "PC2", width: 100 },
        { field: "KVGR3", headerName: "PC3", width: 100 },
        { field: "Organization", headerName: "Organization", hide: true }
    ];

    const gridOptions = {
        columnDefs: columnDefs,
        rowData: [],
        rowHeight: 35,
        headerHeight: 35,
        pagination: false,
        paginationPageSize: 5,
        defaultColDef: {
            sortable: true,
            filter: true,
            floatingFilter: false,
            suppressHeaderMenuButton: true,
        },
    };

    //main table config end

    //popup config start
    const custModelColumnDefs = [
        {
            field: '',
            checkboxSelection: true,
            headerCheckboxSelection: true,
            headerCheckboxSelectionFilteredOnly: true,
            sortable: false,
            filter: false,
            floatingFilter: false,
            width: 40, pinned: 'left'
        },
        { field: "KUNNR", headerName: "Customer Number" },
        { field: "NAME1", headerName: "Customer Name" },
        { field: "xVKORG", headerName: "PCx", hide: true },
        { field: "KVGR1", headerName: "PC1", },
        { field: "KVGR2", headerName: "PC2", },
        { field: "KVGR3", headerName: "PC3", },
        { field: "Organization", headerName: "Organization", hide: true }
    ];

    const custModelGridOptions = {
        columnDefs: custModelColumnDefs,
        rowData: [],
        rowHeight: 35,
        headerHeight: 35,
        pagination: false,
        rowSelection: 'multiple',
        paginationPageSize: 5,
        defaultColDef: {
            sortable: true,
            filter: true,
            floatingFilter: true,
            suppressHeaderMenuButton: true,
        },
    };
    //popup config end


    //disable of elements if organization is not selected
    function DisableIfOrgNotSelected() {
        $("#dp_tradeTemplate").empty()
        $("#dp_tradeTemplate").append("<option value=0> -- Select Trade List Template -- </option>")
        $("#dp_tradeTemplate").prop("disabled", true)
        $("#dp_templateOutput").empty()
        $("#dp_templateOutput").append("<option value=0> -- Select Trade List Formate -- </option>")
        $("#dp_templateOutput").prop("disabled", true)
        $("#listCustomersPopup").prop("disabled", true)
        $("#listCustomersPopup").html("List")
        $(".clear-list").prop("disabled", true)
        $("#addClientToList").prop("disabled", true)
        $("#btn_GeneratePrice").prop("disabled", true)
        $("#input_alter_filename").prop("disabled", true)
        $("#input_AddSod").prop("disabled", true);

        $("#dp_Customertemplates").empty()
        $("#dp_Customertemplates").append("<option value=0> -- Select Customer Template -- </option>")
        //$("#dp_Customertemplates").prop("disabled", true)
    }


    //allow only decimal values
    $('.float-number').keypress(function (event) {
        if ((event.which != 46 || $(this).val().indexOf('.') != -1) && (event.which < 48 || event.which > 57)) {
            event.preventDefault();
        }
    });

    //Default loading of page for saved user configuration
    $(function () {
        //testprice()

        DisableIfOrgNotSelected();
        DefaultSavedUserConfig();
        GetProductOverrideDate();

    })

    //Loading of default saved configuration
    function DefaultSavedUserConfig() {
        $("#processOverlay").css("width", "100%")
        $("#myGrid").empty()
        $("#orgLevel").prop("disabled", true)
        const gridDiv = document.querySelector('#myGrid');
            gridApi = agGrid.createGrid(gridDiv, gridOptions);
        gridApi.sizeColumnsToFit();
        $("#processOverlay").css("width", "100%")
        $.when(
            $.get('/PriceList/GetCountryList'),  // Load Organization
            $.get('/PriceList/GetDiscountsByCountry'), // Load Discounts
            $.get('/PriceList/GetPriceFileSaveConfig'), // User Saved Config
        ).done(function (data1, data2, data3) {
            $("#processOverlay").css("width", "0%")
            maxSelectionCustomers = data1[1] == "success" ? data1[0].MaxSelectCustomers : 0
            $("#maxCustomersCount").val(maxSelectionCustomers)
            var OrgList = data1[1] == "success" ? data1[0].data : []
            var DiscList = data2[1] == "success" ? data2[0] : []
            var UseConfigList = data3[1] == "success" ? data3[0] : []
            var code = UseConfigList?.SalesOrganization.length > 0 ? UseConfigList.SalesOrganization : ""

            // Organization DropDown Binding
            if (OrgList.length > 0) {
                $("#orgLevel").empty()
                var options = '';
                options += '<option value="0">Select</option>';
                for (var i = 0; i < OrgList.length; i++) {
                    options += '<option value="' + OrgList[i].VKORG + '">' + OrgList[i].VKORG + '</option>';
                }
                $('#orgLevel').append(options);
            }

            // Discount Binding
            if (DiscList.length > 0) {
                $("#discountBinding").empty()
                var txt = ""
                for (var i = 0; i < DiscList.length; i++) {
                    txt += "<div class='form-group col-lg-6'><div class='check-controls'>"
                    txt += "<input type='checkbox' class='form-check-input discount-check' id='CanInclude" + DiscList[i].DiscountName + "' onclick='DiscountClicked(this);' >"
                    txt += "<label>Include " + DiscList[i].DiscountName + "<span class='d-none'> - (" + DiscList[i].DiscountValue + ") </span></label>"
                    txt += "</div></div>"
                }
                $("#discountBinding").append(txt)
            }


            // Save User Config Binding
            if (typeof (UseConfigList) == 'object' && UseConfigList != null) {
                $("#orgLevel").val(code)
                $("#org_val").val(code)
                var objarray = []
                var differentOrgExists = false;
                for (let i = 0; i < UseConfigList?.SelectedCustomers.length; i++) {
                    if (code != UseConfigList.SelectedCustomers[i].Organization) {
                        differentOrgExists = true;
                        break;
                    }
                    let obj = {
                        KUNNR: UseConfigList.SelectedCustomers[i].CustomerNumber,
                        NAME1: UseConfigList.SelectedCustomers[i].CustomerName,
                        xVKORG: UseConfigList.SelectedCustomers[i].zKUNNR,
                        KVGR1: UseConfigList.SelectedCustomers[i].PC1,
                        KVGR2: UseConfigList.SelectedCustomers[i].PC2,
                        KVGR3: UseConfigList.SelectedCustomers[i].PC3,
                        Organization: UseConfigList.SelectedCustomers[i].Organization
                    }
                    objarray.push(obj);
                }
                if (differentOrgExists == true) {
                    objarray = []
                    //gridApi.setRowData([]);
                    gridApi.setGridOption("rowData", []);
                    ShowPopupMessage("@PFCWebAPP.Utilities.AppConfig.PopUpHeaderValidation", "@PFCWebAPP.Utilities.AppConfig.DifferentOrgCustomers");

                } else {
                    //gridApi.setRowData(objarray);
                    gridApi.setGridOption("rowData", objarray);
                }

                var today = new Date().toISOString().split('T')[0]
                //if (new Date() >= new Date(UseConfigList?.PricesActiveDate.split('T')[0])) {
                //    $("#active_Data").val(UseConfigList?.PricesActiveDate.split('T')[0])
                //} else {
                $("#active_Data").val(today)
                //}

                $("#active_Data").attr('min', today)
                $("#chk_AddSod").prop("checked", UseConfigList.CanAddSODInFinalPrice)
                if (UseConfigList.CanAddSODInFinalPrice == true) {
                    $("#input_AddSod").prop("disabled", false);
                    $("#input_AddSod").val((UseConfigList.SODInFinalPriceValue * 100) + "%")
                } else {
                    $("#input_AddSod").prop("disabled", true);
                    $("#input_AddSod").val("")
                }

                $("#input_alter_filename").attr('min', today)
                if (UseConfigList.CanUseAlternateValidFromDate == true) {
                    $("#chk_alter_filename").prop("checked", UseConfigList.CanUseAlternateValidFromDate)
                    $("#input_alter_filename").prop("disabled", false);
                    $("#input_alter_filename").val(UseConfigList.AlternateValidFromDate.split('T')[0])
                } else {
                    $("#chk_alter_filename").prop("checked", UseConfigList.CanUseAlternateValidFromDate)
                    $("#input_alter_filename").prop("disabled", true);
                    $("#input_alter_filename").val('')
                }

                $("#chk_IncludePrice").prop("checked", UseConfigList.CanIncludeTradePrices)
                $("#chk_IncludeNetPrice").prop("checked", UseConfigList.CanIncludeCustomerNetPrices)
                $("#chk_CustHirearchy").prop("checked", UseConfigList.CanIncludeCustomerHierarchyNetPrices)
                $("#chk_IncludeOverallPrice").prop("checked", UseConfigList.CanIncludeOverallNetPrices)
                $("#chk_IncludePriceGroup").prop("checked", UseConfigList.CanIncludePriceGroupNets)
                $("#chk_IncludeSaleOffPrice").prop("checked", UseConfigList.CanIncludeSellOffPrices)
                $("#chk_IncludePromoPrice").prop("checked", UseConfigList.CanIncludePromoPrice)
                $("#chk_ShiftBreaks").prop("checked", UseConfigList.CanUseShiftBreaks)
                $("#chk_Moq").prop("checked", UseConfigList.CanUseMOQAsBrk1)
                $("#chk_AutoReport").prop("checked", UseConfigList.CanUseAutoReportContent)
                $("#chk_ShowTemplateMaterialOnly").prop("checked", UseConfigList.CanShowTemplateMaterialOnly)
                $("#chk_UseProductHierarchyOverride").prop("checked", UseConfigList.CanIncludeProductHierarchyOverride)
                if (UseConfigList.CanUseLocalCOSForProductHierarchy == true) {
                    $("#chk_toggle").prop('checked', true)
                } else {
                    $("#chk_toggle").prop('checked', false)
                }

                if (UseConfigList.CanUseAutoReportContent == true) {
                    $("#dp_tradeTemplate").prop("disabled", true)
                    $("#dp_tradeTemplate").val(0);
                } else {
                    $("#dp_tradeTemplate").prop("disabled", false)
                    $("#dp_tradeTemplate").val(UseConfigList.ReportContentTemplateID)
                }
                $("#dp_templateOutput").val(UseConfigList.ReportFormatTemplateID)

                $("#discountBinding input[type='checkbox']").each(function () {
                    $("#" + this.id).prop("checked", UseConfigList[this.id.trim()])
                    if (UseConfigList[this.id.trim()] == true) {
                        $("#" + this.id).siblings('label').find('span').removeClass('d-none')
                    }
                })

                $("#dp_tradeTemplate").prop("disabled", false)
                //$("#listCustomersPopup").prop("disabled", true)
                $("#dp_templateOutput").prop("disabled", false)
                $("#btn_GeneratePrice").prop("disabled", false)
                //$("#listCustomersPopup").html("Fetching Data")
                $("#addClientToList").prop("disabled", false)
                //$("#listCustomersPopup").prop("disabled", false)
                BindTemplates(code, UseConfigList.ReportContentTemplateID, UseConfigList.ReportFormatTemplateID);
                GetCustomersbyOrg(code, objarray)
            }
            else {

                if ($("#orgLevel").val() == "0") {
                    BindTemplates(0, 0, 0);
                    $("#addClientToList").prop("disabled", true)
                    $("#listCustomersPopup").prop("disabled", true)
                    $(".clear-list").prop("disabled", true)
                    //GetCustomersbyOrg($("#orgLevel").val(), [])
                    $("#orgLevel").prop("disabled", false)
                }
                else {
                    BindTemplates($("#orgLevel").val(), 0, 0);
                    GetCustomersbyOrg($("#orgLevel").val(), [])
                    $("#addClientToList").prop("disabled", true)
                    $("#listCustomersPopup").prop("disabled", true)
                    $(".clear-list").prop("disabled", true)
                }

            }

        }).fail(function () {
            $("#processOverlay").css("width", "0%");
            //alert("error:Api failure");
            console.log("error:Api failure");
            //location.reload(true);
            $("#orgLevel").prop("disabled", false)
            $("#displayProcessModal").modal('hide')
            $("#RelanchModal").modal('show');
        })
    }

    // bind template input and output dropdowns
    function BindTemplates(code, template, output) {
        $.when(
            $.get('/PriceList/GetTradeListTemplate?CtryName=' + code),
            $.get('/PriceList/GetTradeListOutputFormate?CtryName=' + code),
            $.get('/PriceList/GetCustomerListTemplate?CtryName=' + code)
        ).done(function (first, second, third) {
            var tradeTemp = first[1] == "success" ? first[0] : []
            var tradeTempOutput = second[1] == "success" ? second[0] : []
            var custListTemp = third[1] == "success" ? third[0] : []
            if (tradeTemp?.length > 0) {
                $("#dp_tradeTemplate").empty()
                var options = '';
                options += '<option value="0"> -- Select Trade List Template -- </option>';
                for (var i = 0; i < tradeTemp.length; i++) {
                    options += '<option value="' + tradeTemp[i].TemplateMasterID + '">' + tradeTemp[i].AliasName + '</option>';
                }
                $('#dp_tradeTemplate').append(options);
            } else {
                $("#dp_tradeTemplate").empty()
                $('#dp_tradeTemplate').append('<option value="0"> -- Select Trade List Template -- </option>');
            }
            $('#dp_tradeTemplate').val(template)

            if (tradeTempOutput?.length > 0) {
                $("#dp_templateOutput").empty()
                var options = '';
                options += '<option value="0"> -- Select Trade List Formate -- </option>';
                for (var i = 0; i < tradeTempOutput.length; i++) {
                    options += '<option value="' + tradeTempOutput[i].ReportFormatMasterID + '">' + tradeTempOutput[i].AliasName + '</option>';
                }
                $('#dp_templateOutput').append(options);
            } else {
                $("#dp_templateOutput").empty();
                $('#dp_templateOutput').append('<option value="0"> -- Select Trade List Formate -- </option>');
            }
            $('#dp_templateOutput').val(output)

            if (custListTemp?.length > 0) {
                $("#dp_Customertemplates").empty()
                var options = '';
                options += '<option value="0"> -- Select Customer Template -- </option>';
                for (var i = 0; i < custListTemp.length; i++) {
                    options += '<option value="' + custListTemp[i].TemplateMasterID + '">' + custListTemp[i].AliasName + '</option>';
                }
                $('#dp_Customertemplates').append(options);
            } else {
                $("#dp_Customertemplates").empty();
                $('#dp_Customertemplates').append('<option value="0"> -- Select Customer Template -- </option>');
            }

            $('#dp_Customertemplates').val(0)

            if (template == 0 || output == 0) {
                $('#dp_templateOutput').prop("disabled", true)
                $('#dp_tradeTemplate').prop("disabled", true)
            }
            else if (template == null || output == null) {
                $('#dp_templateOutput').prop("disabled", false)
                $('#dp_tradeTemplate').prop("disabled", false)
                $('#dp_templateOutput').val("0")
                $('#dp_tradeTemplate').val("0")
            } else {
                $('#dp_templateOutput').prop("disabled", false)
                $('#dp_tradeTemplate').prop("disabled", false)
                $('#dp_templateOutput').val(output)
                $('#dp_tradeTemplate').val(template)
            }


        }).fail(function () {
            $("#processOverlay").css("width", "0%");
            //alert("error:Api failure");
            console.log("error:Api failure");
            //location.reload(true);
            $("#displayProcessModal").modal('hide')
            $("#RelanchModal").modal('show');
        })
    }

