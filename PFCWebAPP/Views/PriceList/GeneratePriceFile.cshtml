    async function handleGeneratePriceClick() {
        const button = document.getElementById("btn_GeneratePrice");
        button.disabled = true;

        try {
            await checkETLJobStatus();
        } catch (error) {
            console.error("ETL check failed:", error);
        } finally {
            button.disabled = false;
        }
    }

    function checkETLJobStatus() {
        return new Promise((resolve, reject) => {
            $.ajax({
                type: 'GET',
                url: '@Url.Action("CheckIfETLJobIsInProgress", "BackOps")',
                data: {},
                dataType: 'json',
                success: function (data) {
                    if (data) {
                        const ETLStartDateTime = moment(data.etlStartDateTime).format("DD-MM-YYYY HH:mm:ss");
                        const ETLEndDateTime = moment(data.etlEndDateTime).format("DD-MM-YYYY HH:mm:ss");

                        const spanElement = document.getElementById('etlStart');
                        const spanElementEtlEnd = document.getElementById('etlEnd');

                        const now = new Date();
                        const aestTime = convertToAEST(now);

                        const convertedETLStartDateTime = new Date(data.etlStartDateTime);
                        const convertedETLEndDateTime = new Date(data.etlEndDateTime);

                        if (aestTime >= convertedETLStartDateTime && aestTime <= convertedETLEndDateTime) {
                            isEtlProcessing = true;
                            showPopup();
                        } else {
                            isEtlProcessing = false;
                            GeneratePriceList();
                        }
                    }
                    resolve(); // Resolve after success
                },
                error: function (error) {
                    console.log(error);
                    reject(error); // Reject on error
                }
            });

            function convertToAEST(date) {
                const AEST_OFFSET = 10 * 60;
                const localOffset = date.getTimezoneOffset();
                return new Date(date.getTime() + (AEST_OFFSET + localOffset) * 60000);
            }
        });
    }



