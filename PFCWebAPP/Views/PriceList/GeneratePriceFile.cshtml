                console.log(data);
                //location.reload(true);
                $("#displayProcessModal").modal('hide')
                $("#RelanchModal").modal('show');
            }
        });
    }
    var isCompleted = false; // Guard flag - To prevent multiple download message popup
    function CheckStatusofPriceFileCalculation(Id, downloadflag) {
        if (isCompleted) return;
        
        $.ajax({
            type: 'Get',
            url: '@Url.Action("GetGenerationStatus", "PriceList")',
            data: { ConfigId: Id },
            datatype: JSON,
            success: function (resp) {
                var data = resp
                if (data != null) {
                    $.ajax({
                        type: 'Post',
                        url: '/PriceList/PopupStatusView',
                        data: {
                            StatusPercentage: data.StatusPercentage,
                            StatusData: data.StatusData,
                            Status: data.Status
                        },
                        datatype: JSON,
                        success: function (resp) {
                            $('#Processmsg').empty()
                            $('#Processmsg').html(resp);
                            $("#Progressbar").text(data.StatusPercentage + "%")
                            $("#Progressbar").css("width", data.StatusPercentage + "%")

                            if (data.StatusPercentage == 100 && downloadflag == true && !isCompleted) {
                                isCompleted = true; // Mark as completed
                                downloadflag = false;
                                clearInterval(intervalId);
                                MessageForAllExcelDownload(data.PriceFileHeaderID);
                                DownloadAllPriceFilesByPriceFileHeaderID(data);
                                $("#displayProcessModal").modal('hide');
                            }
                            else if (data.StatusPercentage == 0) {
                                clearInterval(intervalId);
                                $("#Progressbar").hide();
                                setTimeout(function () {
                                    $("#displayProcessModal").modal('hide');
                                }, 4000)
                            }
                        },
                        error: function (data) {
                            //alert(data);
                            console.log(data);
                            //location.reload(true);
                            $("#displayProcessModal").modal('hide')
                            $("#RelanchModal").modal('show');
                        }
                    });
                }
            },
            error: function (data) {
                //alert(data);
                console.log(data);
                //location.reload(true);
                $("#displayProcessModal").modal('hide')
                $("#RelanchModal").modal('show');
            }
        });
    }

    function DownloadAllPriceFilesByPriceFileHeaderID(data) {
        window.location.href = "@Url.RouteUrl(new { Controller = "Home", Action = "DownLoadAll" })/?PriceFileHeaderID=" + data.PriceFileHeaderID + "&FileName=" + data.ZipFileName;
    }


    function CheckStatus(id, downloadflag) {
        $("#Progressbar").show();
        intervalId = setInterval(function () {
