    //Load customers
    function GetCustomersbyOrg(code, mdata) {
        $("#btn_GeneratePrice").prop("disabled", false)
        $("#listCustomersPopup").html("Fetching Data")
        $("#listCustomersPopup").prop("disabled", true)
        $(".clear-list").prop("disabled", true)
        $("#addClientToList").prop("disabled", true)
        $("#orgLevel").prop("disabled", true)
        $.ajax({
            type: 'Get',
            url: '@Url.Action("GetCustomerByCountry", "PriceList")',
            data: { ctrycode: code },
            datatype: JSON,
            success: function (data) {
                $("#modelGrid").empty()
                const modelDiv = document.querySelector('#modelGrid');
                //new agGrid.Grid(modelDiv, custModelGridOptions);
                modelgridApi = agGrid.createGrid(modelDiv, custModelGridOptions);
                //custModelGridOptions.api.setRowData([]);
                modelgridApi.setGridOption("rowData", []);
                if (data?.length != 0) {
                    $("#listCustomersPopup").html("List")
                    $("#listCustomersPopup").prop("disabled", false)
                    $(".clear-list").prop("disabled", false)
                    $("#addClientToList").prop("disabled", false)
                    $("#orgLevel").prop("disabled", false)
                    $("#modelGrid").empty()
                    const modelDiv = document.querySelector('#modelGrid');
                    //new agGrid.Grid(modelDiv, custModelGridOptions);
                    modelgridApi = agGrid.createGrid(modelDiv, custModelGridOptions);
                    LoadCustGrid(data)
                    if (mdata.length > 0) {
                        const map = new Map();
                        mdata.forEach(obj => {
                            map.set(obj.KUNNR, obj)
                        });
                        modelgridApi.forEachNode((rowNode, index) => {
                            if (map.has(rowNode.data.KUNNR)) {
                                rowNode.setSelected(true);
                            }
                        });
                    }

                } else {
                    $("#modelGrid").empty()
                    const modelDiv = document.querySelector('#modelGrid');
                    //new agGrid.Grid(modelDiv, custModelGridOptions);
                    modelgridApi = agGrid.createGrid(modelDiv, custModelGridOptions);
                    $("#listCustomersPopup").prop("disabled", false)
                    $(".clear-list").prop("disabled", false)
                    $("#addClientToList").prop("disabled", false)
                    LoadCustGrid([])
                }
            },
            error: function (data) {
                $("#processOverlay").css("width", "0%")
                //alert(data);
                console.log(data);
                //location.reload(true);
                $("#displayProcessModal").modal('hide')
                $("#RelanchModal").modal('show');
            }
        });
    }

